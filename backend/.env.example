# Database — for production use PostgreSQL:
#   postgresql+asyncpg://user:pass@host:5432/ec_dashboard
# Default (demo): local SQLite file
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ec_dashboard

# JWT — REQUIRED in production (generate with: openssl rand -hex 32)
JWT_SECRET=please-change-this-to-a-real-32-char-secret
JWT_EXPIRE_DAYS=7

# Initial platform admin — used ONCE on first startup, when the users table
# has no superadmin yet. Change these BEFORE first deploy; afterwards the
# password lives in the DB (bcrypt-hashed) and these env vars are ignored.
PLATFORM_ADMIN_USERNAME=cjx
PLATFORM_ADMIN_PASSWORD=please-set-a-strong-password

# Upload limit
UPLOAD_MAX_MB=20

# Misc
DEBUG=false
CORS_ORIGINS=["https://your-domain.example.com"]
